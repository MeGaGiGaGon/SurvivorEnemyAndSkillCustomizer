<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		
		<PackageReference Include="R2API.Networking" Version="*" />

		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
		<PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
		<PackageReference Include="RoR2BepInExPack" Version="*" />
	</ItemGroup>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="echo $(OutDir)&#xD;&#xA;echo $(ProjectDir)&#xD;&#xA;echo $(AssemblyName)&#xD;&#xA;echo $(ProjectDir)$(OutDir)$(AssemblyName)" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="copy /y $(ProjectDir)$(OutDir)$(AssemblyName).dll $(ProjectDir)..\Thunderstore" />
	</Target>

</Project>